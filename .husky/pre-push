# Pre-push hook: run all quality gates before pushing to remote
# (typecheck, lint, cspell, ast-grep, format, i18n, rust fmt/clippy/machete,
# frontend tests, rust tests). E2E is intentionally not run here — it needs
# a dev server and is covered by CI.
echo "Running all quality gates (npm run check:all)..."
npm run check:all || { echo "❌ Quality gates failed. Push aborted."; exit 1; }

echo "✅ All quality gates passed. Proceeding with push."
